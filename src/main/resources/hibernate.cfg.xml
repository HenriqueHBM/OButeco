        <!-- Dialeto (Hibernate 6) -->
        <!--        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>-->
        <!-- Atualização automática do schema -->
        <property name="hibernate.hbm2ddl.auto">none</property>
        <!-- Logs SQL -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">true</property>
        <!-- Mapeamento das entidades -->

        <!-- Produto -->
        <mapping class="buteco.model.entity.produto.Produto" />
        <mapping class="buteco.model.entity.produto.Categoria" />
        <mapping class="buteco.model.entity.conversao.ConversoesEntity" />
        <mapping class="buteco.model.entity.produto.InsumosProduto" />
        <mapping class="buteco.model.entity.produto.Grupo" />

        <!-- Estoque -->
        <mapping class="buteco.model.entity.estoque.EstoqueEntity" />
        <mapping class="buteco.model.entity.estoque.MovimentacoesEstoqueEntity" />

        <!-- Usuario -->
        <mapping class="buteco.model.entity.pessoa.UsuarioEntity" />
        <mapping class="buteco.model.entity.pessoa.CargoEntity" />

        <!-- Fim Produto -->
    </session-factory>
</hibernate-configuration>